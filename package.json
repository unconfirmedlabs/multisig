{
  "name": "@unconfirmedlabs/multisig",
  "version": "0.1.0",
  "description": "Effect-powered native Sui multisig CLI with YubiKey PIV signing",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "bun@1.4.0",
  "bin": {
    "multisig": "dist/multisig"
  },
  "scripts": {
    "dev": "bun src/main.ts",
    "build": "bun build src/main.ts --compile --outfile dist/multisig",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "install:local": "bun run scripts/install.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/unconfirmedlabs/multisig.git"
  },
  "dependencies": {
    "@mysten/sui": "2.38.0",
    "@noble/curves": "^2.0.0",
    "@noble/hashes": "^2.0.0",
    "effect": "^3.22.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "1.4.4",
    "typescript": "^5.9.3"
  }
}
